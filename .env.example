# Copy to .env and fill in. Never commit .env.

# --- required in production -------------------------------------------------
ARACARE_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ARACARE_SECRET_KEY=
POSTGRES_PASSWORD=
# Creates the first admin (username "admin") on an empty database; they must change it at first login.
# Remove it from .env once you have logged in.
ARACARE_ADMIN_PASSWORD=
# Where the web client is served from (comma separated)
ARACARE_CORS_ORIGINS=http://aracare.local,http://192.168.1.10:5173

# --- facility ------------------------------------------------------------------
ARACARE_FACILITY_NAME=General Hospital Ikeja
ARACARE_STATE_CODE=LAG
ARACARE_TIMEZONE=Africa/Lagos

# --- optional --------------------------------------------------------------------
ARACARE_ENABLE_DOCS=false
ARACARE_LOG_LEVEL=INFO
ARACARE_TOKEN_TTL_HOURS=12
# AI scribe: build with WITH_SCRIBE=1 for local Whisper; run Ollama on the host for note drafting
WITH_SCRIBE=0
ARACARE_WHISPER_MODEL=small
ARACARE_LLM_ENGINE=auto
ARACARE_OLLAMA_MODEL=qwen2.5:7b
